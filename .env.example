# Copy to .env and fill in. Everything here has a working default except the
# UPI ID, which is what makes real payments possible.

# ---------------------------------------------------------------- the site
# Public URL of the deployment. Used by the Android shell and in share links.
EHB_APP_URL=

# Signing secret for session tokens. REQUIRED in production: without it a fresh
# secret is generated on boot, so everyone is signed out on every restart.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ATITHI_JWT_SECRET=
# Session lifetime in seconds (default 30 days).
ATITHI_JWT_TTL=2592000

# Where accounts, bookings, payments and reviews are written.
# Defaults to .data/ locally and /tmp on serverless hosts — see lib/store.js for
# what that means for durability.
EHB_DATA_DIR=

# ------------------------------------------------------------ UPI payments
# The UPI ID that receives payments. Money moves directly from the guest's bank
# to this account; there is no aggregator and nothing to settle afterwards.
# Leave blank and the app offers pay-at-property only.
EHB_UPI_VPA=
EHB_UPI_PAYEE_NAME=Easy Hotel Booking
# Optional merchant category code, if the payee account has one.
EHB_UPI_MERCHANT_CODE=

# ------------------------------------------------------------- photography
# Base URL for listing photographs. The default is a placeholder photo service;
# point this at your own CDN once real property photos are available.
# NEXT_PUBLIC_PHOTO_SOURCE=https://picsum.photos/seed

# --------------------------------------------------------- Android release
# Play Store versioning. Play rejects a bundle whose code is not higher than the
# last upload.
EHB_VERSION_CODE=1
EHB_VERSION_NAME=1.0.0

# Release signing. Create the keystore with mobile/scripts/make-keystore.sh.
# Relative paths resolve against mobile/android/.
EHB_KEYSTORE_PATH=keystore/easy-hotel-booking-release.jks
EHB_KEYSTORE_PASSWORD=
EHB_KEY_ALIAS=easyhotelbooking
EHB_KEY_PASSWORD=
