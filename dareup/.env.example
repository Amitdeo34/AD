# DareUp server settings. Copy to .env for `npm run dev`, and add the same names in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Razorpay API keys (Dashboard > Account & Settings > API Keys).
# Start with test keys (rzp_test_...), switch to live keys (rzp_live_...) when ready.
RAZORPAY_KEY_ID=rzp_test_[your-key-id]
RAZORPAY_KEY_SECRET=[your-key-secret]

# Signs premium pass tokens. At least 32 random characters. Changing it logs out every pass.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PASS_SECRET=[at-least-32-random-characters]

# Optional: comma-separated origins allowed to call the API. Empty = any origin.
# The Android app is https://appassets.androidplatform.net ; file:// pages send "null".
ALLOWED_ORIGINS=

# Optional: 1 = fake payments that unlock a free demo pass (no Razorpay calls).
# Only for trying the flow. Never set it on the live site. Demo passes stop working when it is off.
DEMO_MODE=

# Optional: name the server returns to the game (the game uses its own APP_NAME config).
APP_NAME=DareUp
